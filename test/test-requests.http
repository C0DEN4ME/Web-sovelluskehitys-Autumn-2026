### get cats
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/2

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat with non specific token
POST {{apiUrl}}/cats
Content-Type: application/json
Authorization: Bearer <jwt-token>

{
  "cat_name": "Princess Donut",
  "weight": 4.5,
  "owner": "38",
  "filename": "https://static.wikia.nocookie.net/dungeon-crawler-carl/images/5/56/Donut_by_Mashermello.png/revision/latest?cb=20251024191920",
  "birthdate": "2020-01-01"
}

### post new cat with valid token
POST {{apiUrl}}/cats
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cat_name": "Princess Donut",
  "weight": 4.5,
  "filename": "https://static.wikia.nocookie.net/dungeon-crawler-carl/images/5/56/Donut_by_Mashermello.png/revision/latest?cb=20251024191920",
  "birthdate": "2020-01-01"
}

### post cat WITH IMAGE
POST {{apiUrl}}/cats
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Princess Donut
--MyBoundary
Content-Disposition: form-data; name="weight"

4.5
--MyBoundary
Content-Disposition: form-data; name="owner"

Carl
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2020-01-01
--MyBoundary
Content-Disposition: form-data; name="image"; filename="cat.jpg"
Content-Type: image/jpeg

< ./cat.jpg
--MyBoundary--

### edit existing cat
PUT {{apiUrl}}/cats/2
Content-Type: application/json

{
  "weight": 6,
  "owner": "New owner"
}

### delete cat by id
DELETE {{apiUrl}}/cats/2


### get cats by user id
GET {{apiUrl}}/cats/user/38


## /users

### REGISTER NEW USER
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Carl",
  "username": "Carl-1",
  "email": "carl@example.com",
  "password": "secret"

}
### LOGIN USER
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "Carl-1",
  "password": "secret"
}

#### LOGIN USER (FAIL: wrong password)
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "Carl-1",
  "password": "wrongpassword"
}

### get user by id
GET {{apiUrl}}/users/39

### /auth
GET {{apiUrl}}/auth/me
Authorization: Bearer {{token}}

### edit own cat
PUT {{apiUrl}}/cats/43
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "weight": 6
}

### edit someone else's cat
PUT {{apiUrl}}/cats/41
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "weight": 9
}

### delete without token
DELETE {{apiUrl}}/cats/41

### all users, no passwords (expect 200)
GET {{apiUrl}}/users


### one user (expect 200)
GET {{apiUrl}}/users/38

#### edit user (expect 200)
PUT {{apiUrl}}/users/38
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Carl-1"
}
##### edit someone elses user (expect 403)
PUT {{apiUrl}}/users/37
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Hacked"
}

### try to become admin (expect 403)
PUT {{apiUrl}}/users/38
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "role": "admin"
}
