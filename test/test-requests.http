# api http test requests for VS Code REST Client
@apiUrl = http://127.0.0.1:3000/api/v1

@token = {{$dotenv TOKEN}}
GET {{apiUrl}}/cats

### get cat by id
GET {{apiUrl}}/cats/2

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

### post new cat with non specific token
POST {{apiUrl}}/cats
Content-Type: application/json
Authorization: Bearer <jwt-token>

{
  "cat_name": "Princess Donut",
  "weight": 4.5,
  "owner": "38",
  "filename": "https://static.wikia.nocookie.net/dungeon-crawler-carl/images/5/56/Donut_by_Mashermello.png/revision/latest?cb=20251024191920",
  "birthdate": "2020-01-01"
}

### post new cat with valid token
POST {{apiUrl}}/cats
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cat_name": "Princess Donut",
  "weight": 4.5,
  "filename": "https://static.wikia.nocookie.net/dungeon-crawler-carl/images/5/56/Donut_by_Mashermello.png/revision/latest?cb=20251024191920",
  "birthdate": "2020-01-01"
}

### post cat WITH IMAGE
POST {{apiUrl}}/cats
Content-Type: multipart/form-data; boundary=MyBoundary
Authorization: Bearer {{token}}

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Princess Donut
--MyBoundary
Content-Disposition: form-data; name="weight"

4.5
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2020-01-01
--MyBoundary
Content-Disposition: form-data; name="image"; filename="big.jpg"
Content-Type: image/jpeg

< ./big.jpg
--MyBoundary--

### edit existing cat
PUT {{apiUrl}}/cats/2
Content-Type: application/json

{
  "weight": 6,
  "owner": "New owner"
}

### delete cat by id
DELETE {{apiUrl}}/cats/2


### get cats by user id
GET {{apiUrl}}/cats/user/38


## /users

### REGISTER NEW USER
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "Carl The Crawler",
  "username": "Carl1",
  "email": "carl1@example.com",
  "password": "secret"

}


### REGISTER NEW USER with invalid fields (FAIL: validation error)
POST {{apiUrl}}/users
Content-Type: application/json

{
  "name": "#€#",
  "username": "Carl-2",
  "email": "carl.example.com",
  "password": "se"

}

### LOGIN USER
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "Carl-1",
  "password": "secret"
}

#### LOGIN USER (FAIL: wrong password)
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "Carl-1",
  "password": "wrongpassword"
}
#### LOGIN USER (FAIL: wrong username)
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "Carl-2",
  "password": "secret"
}

### get user by id
GET {{apiUrl}}/users/39

### /auth
GET {{apiUrl}}/auth/me
Authorization: Bearer {{token}}

### edit own cat
PUT {{apiUrl}}/cats/43
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "weight": 6
}

### edit someone else's cat
PUT {{apiUrl}}/cats/41
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "weight": 9
}

### delete without token
DELETE {{apiUrl}}/cats/41

### all users, no passwords (expect 200)
GET {{apiUrl}}/users


### one user (expect 200)
GET {{apiUrl}}/users/38

#### edit user (expect 200)
PUT {{apiUrl}}/users/38
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Carl-1"
}
##### edit someone elses user (expect 403)
PUT {{apiUrl}}/users/37
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Hacked"
}

### try to become admin (expect 400)
PUT {{apiUrl}}/users/38
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "role": "admin"
}

### unknown route (expect 404 JSON)
GET {{apiUrl}}/dogs

### invalid JSON body (expect 400 JSON instead of an HTML page)
POST {{apiUrl}}/users
Content-Type: application/json

{ "name": "broken",}

#### get cats by user id
GET {{apiUrl}}/cats/user/999
### test error handling (expect 404)
GET {{apiUrl}}/error


### test not found (expect 404)
GET {{apiUrl}}/nonexistent-endpoint

### post new cat with valid token but with invalid fields (expect 400)
POST {{apiUrl}}/cats
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cat_name": "Pr",
  "weight": 4.5,
  "filename": "donut.png",
  "birthdate": "2.Marraskuuta"
}

### login with empty body (expect 400)
POST {{apiUrl}}/auth/login

### login without username (expect 400)
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "password": "secret"
}

### login without password (expect 400)
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "username": "Carl-1"
}

### post cat WITH fake IMAGE
POST {{apiUrl}}/cats
Content-Type: multipart/form-data; boundary=MyBoundary
Authorization: Bearer {{token}}

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Princess Donut
--MyBoundary
Content-Disposition: form-data; name="weight"

4.5
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2020-01-01
--MyBoundary
Content-Disposition: form-data; name="image"; filename="fake.png"
Content-Type: image/png

< ../package.json
--MyBoundary--


